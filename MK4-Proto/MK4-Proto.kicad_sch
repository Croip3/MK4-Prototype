	)
	(text "SUPPLY / ARMING\n4.5-12V Rail (after POWER switch SW201) -> SW103 ARM -> PowerRailControl\nSW103 open = ignition side unpowered\n(hardware interlock, independent of firmware)\nC106 2200µ buffers the firing current pulses"
		(exclude_from_sim no)
		(at 40 44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3060fe14-b5c3-4f3d-a904-3ae5a55c68d0")
	)
	(text "CHANNEL DRIVER U102 74HC595\nSER=IO6, SRCLK=IO5, RCLK=IO4, /OE=IO21\nQA-QH -> Channel 1-8 (gates Q401-Q408)\nQH' unused (cascade for >8 channels)"
		(exclude_from_sim no)
		(at 237 146 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "80689843-fb28-424c-9590-ccf13b7958f3")
	)
	(text "FIRING CHAIN\n1. POWER (SW201) and ARM (SW103) closed\n2. IO15 -> Q301 switches the Ignition Rail ON\n3. 74HC595 output n -> channel FET Q40n fires igniter n\nCONTINUITY TEST: IO14 feeds 3.3 V via 1k into the rail,\nIO7 reads each channel via the ADC mux (IO9-IO11)"
		(exclude_from_sim no)
		(at 40 59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a15dbc15-39b2-42a8-bdba-163567986857")
	)
	(text "MCU U101 ESP32-S3-WROOM-1\nSW101 RESET: EN with RC R101/C103 (~10 ms power-on delay)\nSW102 BOOT: IO0 low at reset -> download mode, R102 pull-up\nC101 10µ / C102 100n: 3V3 bulk + decoupling at the module\nUSB D+/D- from J201 (ESD U202) -> native USB (flash + CDC)"
		(exclude_from_sim no)
		(at 15 172 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bc0d999c-b999-4267-81b7-9b6aaec3d507")
	)
	(text "GPIO MAP\nIO3  Battery voltage (ADC)\nIO4/5/6  74HC595 RCLK / SRCLK / SER\nIO21  74HC595 /OE\nIO7  Continuity mux output (ADC)\nIO8  Ignition rail voltage (ADC)\nIO9/10/11  Mux select A2 / A1 / A0\nIO14  Rail test current ON\nIO15  Ignition rail ON\nIO16  WS2812B data\nIO19/20  USB D- / D+"
		(exclude_from_sim no)
		(at 237 116 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ea33124a-c344-4dd8-a445-f42fe5c60067")
	)
	(text "BATTERY SENSE -> IO3 (ADC1)\nR104/R105 100k/27k: 0-15.5 V -> 0-3.3 V\nC105 10n low-pass"
		(exclude_from_sim no)
		(at 40 107 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f4e4822c-7c3b-46b1-b461-401c0a8e0d3e")
	)
