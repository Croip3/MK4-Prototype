	(text "IGNITION RAIL SWITCH (high side)\nQ301 AO3401A P-FET: 5V-12V (after ARM) -> Ignition Rail\nR301 10k pulls the gate to source -> rail OFF by default\nIO15 (Trigger 12V on Rail) -> R303 100R -> Q302 AO3400A\nR304 100k keeps Q302 off while the MCU boots\nQ302 on -> R302 4.7k pulls Q301 gate low -> rail ON\nVgs(Q301) ~ -0.68 x Vin (-8.2 V @ 12 V, -3.4 V @ 5 V)"
		(exclude_from_sim no)
		(at 168 44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1740fcc0-7a1e-40e9-a825-2d7c1de1e15c")
	)
	(text "RAIL TEST CURRENT (continuity check)\nIO14 (Trigger 3.3V on Rail) -> R305 1k -> D301 -> Ignition Rail\nCurrent limited to < 2.6 mA, well below igniter no-fire current\nD301 blocks the 12 V rail from back-feeding the GPIO"
		(exclude_from_sim no)
		(at 100 130 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c0f6acb4-5ead-4a99-bd66-af35b11c0ddb")
	)
