	)
	(text "BATTERY INPUT\nBT201 (5-12 V) -> D201 reverse-\npolarity protection -> SW201 POWER\n-> 4.5-12V Rail: ARM switch (root)\nand via D202 to the buck VIN"
		(exclude_from_sim no)
		(at 57 99 0)
		(effects
