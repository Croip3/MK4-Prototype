	(text "3.3 V BUCK U201 TPS62933 (3.8-30 V in, 3 A)\nD202/D203 diode-OR: battery rail or USB VBUS -> VIN\nUSB powers the logic only, never the ignition rail\nFB R203/R204: Vout = 0.8 V x (1 + 31.3k/10k) = 3.30 V\nEN R201/R202: UVLO, turns on at VIN ~4.4 V\nC205 33n soft-start, C206 bootstrap, RT open\nC201-C203 input, C204 2200µ bulk, C207/C208 output"
		(exclude_from_sim no)
		(at 115.062 82.042 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "28519db0-5cbf-49f8-ba5b-22fa617bc4c2")
	)
	(text "USB-C J201 (USB 2.0, sink)\nR205/R206 5.1k on CC1/CC2 -> 5 V default\nU202 USBLC6-2: ESD protection D+/D-\nSBU1/SBU2 unused"
		(exclude_from_sim no)
		(at 150 127 0)
		(effects
