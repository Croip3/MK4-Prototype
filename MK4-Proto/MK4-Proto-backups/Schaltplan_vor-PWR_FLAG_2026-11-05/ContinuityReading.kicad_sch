	(text "MUX SUPPLY: MUX Supply (4.5-12V Rail, before ARM) -> R701 / R1001 100R -> VDD\nC709 / C1009 1µ + C710 / C1010 100n at VDD (TMUX4051: VDD 5-24 V)"
		(exclude_from_sim no)
		(at 65 44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "34eed440-7117-4098-93b1-aa4c2334b3b8")
	)
	(text "ADC MUX TMUX4051 (8:1): U701 (Bank A) / U1001 (Bank B)\nA0/A1/A2 = IO13/IO12/IO11 (shared), S0..S7 = Channel 1..8\nD -> IO7 (ADC1), shared by both banks\n/EN = Sense Enable (active low): Bank A IO6, Bank B IO5\n-> enable only one mux at a time"
		(exclude_from_sim no)
		(at 115 128 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "987a9875-2cc6-4834-acd2-15146c1bcd80")
	)
	(text "CHANNEL SENSE (one per channel)\nSense Channel n -> 100k / 27k divider + 10n -> mux input S(n-1)\nBank A: Ch1-4 RN701 (100k) / RN702 (27k), Ch5-8 RN703 / RN704, C701-C708\nBank B: Ch1-4 RN1001 / RN1002, Ch5-8 RN1003 / RN1004, C1001-C1008\nIgniter connected -> node follows the rail voltage, open -> ~0 V"
		(exclude_from_sim no)
		(at 65 20 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e8ce65cc-0ab2-41b6-811c-3d07198e932b")
	)
